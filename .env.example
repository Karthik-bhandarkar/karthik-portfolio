# ==============================================================================
# Portfolio Environment Variables Configuration
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env.local
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL) - Required for live editing & contact messages
# ------------------------------------------------------------------------------
# For Local Development / Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

# For Neon Serverless (Vercel recommended):
# DATABASE_URL="postgresql://<username>:<password>@<ep-name>.neon.tech/<dbname>?sslmode=require"

# For Supabase:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# For Railway / Render:
# DATABASE_URL="postgresql://postgres:<password>@<host>.railway.app:5432/railway"

# ------------------------------------------------------------------------------
# 2. Studio Admin Authentication - Required for Studio CMS (/studio)
# ------------------------------------------------------------------------------
# Minimum 16 characters required for security; 32+ recommended.
# Generate one with: openssl rand -hex 24
PORTFOLIO_ADMIN_TOKEN="change-me-to-a-secure-secret-token-at-least-16-chars"

# ------------------------------------------------------------------------------
# 3. Canonical Site URL & Metadata
# ------------------------------------------------------------------------------
# Used for SEO tags, OpenGraph images, sitemaps, and robots.txt.
# In local dev: http://localhost:3000
# In production: https://karthikbhandarkar.com or https://<your-project>.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Node Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
